import random


def uniform_points(n, seed):
    rng = random.Random(seed)
    return [(rng.random(), rng.random()) for _ in range(n)]
def estimate_pi(points):
    inside = sum(1 for x, y in points if x * x + y * y < 1.0)
    return 4.0 * inside / len(points)
